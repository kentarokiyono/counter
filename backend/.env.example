# ==========================================================================
# Toloc OS — backend 環境変数テンプレート
# 使い方: このファイルを backend/ に `.env` としてコピーし、<...> を実際の値に置き換える。
#   cp .env.example .env
# uvicorn は backend/ 内で起動すること（.env を読むため）。
# ==========================================================================

# --- 必須 ---
SUPABASE_URL=<Supabase の Project URL>
SUPABASE_SERVICE_ROLE_KEY=<Secret key（sb_secret_...）・フロントには絶対置かない>

# --- 任意 ---
# APP_ENV=development
# CORS_ALLOW_ORIGINS=http://localhost:3000

# --- ログイン（Googleログイン）---
# 最初の管理者のメール（カンマ区切り）。初回ログイン時に管理者として自動登録される。
# ADMIN_EMAILS=<大学メール>
# ログインを許可するメールのドメイン（カンマ区切り・サブドメインも許可。既定 osaka-u.ac.jp）
# ALLOWED_EMAIL_DOMAIN=osaka-u.ac.jp
# ローカル開発で認証を省く場合のみ true（APP_ENV=production では無視される）
# AUTH_DISABLED=true

# --- 定期実行・通知・カレンダー ---
# CRON_SECRET=<長いランダム文字列>
# CALENDAR_FEED_TOKEN=<長いランダム文字列>
# DISCORD_WEBHOOK_URL=<Discord ウェブフック URL>
# DISCORD_ALERT_WEBHOOK_URL=<エラー通知用。未設定なら DISCORD_WEBHOOK_URL>
# VAPID_PUBLIC_KEY=<python -m push_keys の出力>
# VAPID_PRIVATE_KEY=<python -m push_keys の出力>
# VAPID_SUBJECT=mailto:<管理者のメール>
