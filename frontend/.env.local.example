# ==========================================================================
# Toloc OS — frontend 環境変数テンプレート（ローカル開発用）
#   cp .env.local.example .env.local
# NEXT_PUBLIC_ の変数はブラウザに露出する。service_role キーは絶対に置かないこと。
# ==========================================================================

# バックエンド API のベース URL
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- 必須 ---
NEXT_PUBLIC_SUPABASE_URL=<Supabase の Project URL・backend と同じ>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<Publishable key（sb_publishable_...）>

# --- 任意 ---
# ログイン方法: google（既定）/ azure（Microsoft 365）
# NEXT_PUBLIC_AUTH_PROVIDER=google
# NEXT_PUBLIC_MEMBER_EMAIL_DOMAIN=ecs.osaka-u.ac.jp
# NEXT_PUBLIC_LOGIN_HINT_DOMAIN=
