# 本番ビルド用の公開設定（NEXT_PUBLIC_* はブラウザに露出する前提の値）。
# Next.js が本番ビルド時に読み込み、コードへ焼き込む。Vercel の環境変数があればそちらが優先される。
# ※ service_role / sb_secret キー等の秘密は絶対に置かない（バックエンドの環境変数に置く）。
# 値は Toloc 用の Supabase・バックエンドを作成したあとに記入する（docs/SETUP.md）。
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 大学アカウントが Microsoft 365 の場合は azure（既定 google）
NEXT_PUBLIC_AUTH_PROVIDER=google
# メンバー追加でメールの @ 以降を省略したときに補うドメイン
NEXT_PUBLIC_MEMBER_EMAIL_DOMAIN=ecs.osaka-u.ac.jp
# （任意）Google ログイン画面で優先表示するドメイン
NEXT_PUBLIC_LOGIN_HINT_DOMAIN=
